// Generated by designPerspectives. Edit through the app or `dp`; hand edits are re-formatted on save.
deployment {
  development = environment "Development" {
    description "A developer's machine plus shared test systems in the bank."
    dataCentre = node "Bank Data Centre" {
      technology "On-premises data centre"
      description "The bank's own hosting facility."
      corebankingDev = node "corebanking-dev" {
        technology "Server"
        description "Shared development instance of the core banking system."
        corebanking = instanceOf corebanking
      }
    }
    laptop = node "Developer Laptop" {
      technology "Windows or macOS"
      description "Workstation used to build and run the system locally."
      browser = node "Web Browser" {
        technology "Chrome, Firefox, Safari or Edge"
        description "Runs the front end during local development."
        spa = instanceOf ibs.spa
      }
      docker = node "Docker" {
        technology "Docker Engine"
        description "Local container runtime hosting the back end and its dependencies."
        backend = node "Backend Container" {
          technology "Docker container"
          description "Runs the API application and serves the front-end files."
          api = instanceOf ibs.api
          staticContent = instanceOf ibs.staticContent
        }
        mockEmail = node "Mock Email Service" {
          technology "Docker container"
          description "Fake e-mail service from another team; logs messages instead of sending."
          ses = instanceOf ses
        }
        mysql = node "Database Container" {
          technology "Docker container, MySQL"
          description "Disposable local copy of the database schema."
          db = instanceOf ibs.db
        }
        objectStore = node "Local object store (MinIO)" {
          technology "Docker container, MinIO"
          description "S3-compatible stand-in for the cloud statement bucket."
          statementStore = instanceOf ibs.statementStore
        }
      }
    }
  }
  live = environment "Live" {
    description "Production hosting used by real customers."
    aws = node "Amazon Web Services" {
      technology "AWS region"
      description "Cloud region hosting the internet banking workloads."
      cdn = node "Content Delivery Network" {
        technology "CDN backed by object storage"
        description "Serves the front-end files to browsers from edge locations."
        staticContent = instanceOf ibs.staticContent
      }
      containerService = node "Container Service" {
        technology "Managed container service"
        description "Runs and scales the back-end containers."
        api = instanceOf ibs.api
      }
      email = node "Email Service" {
        technology "Amazon SES"
        description "The provider's e-mail delivery service."
        ses = instanceOf ses
      }
      managedMysql = node "Managed MySQL" {
        technology "Managed relational database service, MySQL"
        description "Provider-operated MySQL with backups and failover."
        db = instanceOf ibs.db
      }
      objectStorage = node "Object Storage" {
        technology "Amazon S3"
        description "Holds the bucket of cached statements."
        statementStore = instanceOf ibs.statementStore
      }
    }
    customerDevice = node "Customer's Computer" {
      technology "Desktop or laptop"
      description "Device a customer uses to reach online banking."
      browser = node "Web Browser" {
        technology "Chrome, Firefox, Safari or Edge"
        description "Runs the front end for the customer."
        spa = instanceOf ibs.spa
      }
    }
    dataCentre = node "Bank Data Centre" {
      technology "On-premises data centre"
      description "The bank's own hosting facility."
      corebankingServers = node "Core Banking Servers" {
        technology "Server cluster"
        description "Production servers running the core banking system."
        corebanking = instanceOf corebanking
      }
    }
  }
}
