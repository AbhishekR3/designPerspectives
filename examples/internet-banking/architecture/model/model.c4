// Generated by designPerspectives. Edit through the app or `dp`; hand edits are re-formatted on save.
model {
  corebanking = softwareSystem "Core Banking System" {
    #external
    description "Packaged system of record for customer accounts and transactions, exposed through an API."
  }
  customer = person "Personal Banking Customer" {
    description "A bank customer who holds one or more personal accounts."
  }
  ibs = softwareSystem "Internet Banking System" {
    description "Gives customers online access to their accounts, statements and payments."
    api = container "API Application" {
      technology "Java and Spring Boot"
      description "Server-side banking logic offered to the front end as a JSON API."
      accountsSummaryApi = component "Accounts Summary API" {
        technology "Spring Web MVC"
        description "Endpoint returning an overview of a customer's accounts."
      }
      coreBankingAdapter = component "Core Banking System Adapter" {
        technology "Spring Bean"
        description "Translates internal requests into calls on the core banking API."
      }
      email = component "Email Component" {
        technology "Spring Bean"
        description "Composes and dispatches notification e-mails to customers."
      }
      security = component "Security Component" {
        technology "Spring Bean"
        description "Checks credentials, issues tokens and validates them on later requests."
      }
      signInApi = component "Sign In API" {
        technology "Spring Web MVC"
        description "Endpoint where customers authenticate and obtain an access token."
      }
      statementApi = component "Statement API" {
        technology "Spring Web MVC"
        description "Endpoint returning account statements as PDF documents."
      }
      statements = component "Statement Component" {
        technology "Spring Bean"
        description "Produces statements, reusing cached copies where they already exist."
      }
    }
    db = dataStore "Database" {
      technology "MySQL database schema"
      description "Keeps customer login credentials and related security data."
    }
    spa = container "Single-Page Application" {
      technology "JavaScript and Angular"
      description "Browser-based user interface for all online banking features."
    }
    statementStore = dataStore "Statement Store" {
      technology "Amazon S3 bucket"
      description "Cache of previously generated PDF account statements."
    }
    staticContent = dataStore "Static Content" {
      technology "Directory of static HTML, CSS and JavaScript files"
      description "Holds the built files that make up the single-page application."
    }
  }
  ses = softwareSystem "Amazon Simple Email Service" {
    #external
    description "Cloud e-mail delivery service the bank already relies on."
  }
  customer -[calls]-> ibs "Checks balances and pays bills with"
  customer -[calls]-> ibs.spa "Checks balances and pays bills with"
  ibs -[calls]-> corebanking "Retrieves account data and submits payments via"
  ibs -[calls]-> ses "Sends notification e-mails via"
  ibs.api -[calls]-> corebanking "Retrieves account data and submits payments via" {
    technology "XML/HTTPS"
  }
  ibs.api -[readsFrom]-> ibs.db "Reads from and writes to" {
    technology "SQL/TCP"
  }
  ibs.api -[readsFrom]-> ibs.statementStore "Reads from and writes to" {
    technology "S3 API/HTTPS"
  }
  ibs.api -[calls]-> ses "Sends notification e-mails via" {
    technology "HTTPS"
  }
  ibs.api.accountsSummaryApi -[calls]-> ibs.api.coreBankingAdapter "Fetches account summaries via" {
    technology "Java method call"
  }
  ibs.api.accountsSummaryApi -[calls]-> ibs.api.security "Validates access tokens with" {
    technology "Java method call"
  }
  ibs.api.coreBankingAdapter -[calls]-> corebanking "Makes API calls to" {
    technology "XML/HTTPS"
  }
  ibs.api.email -[calls]-> ses "Sends e-mails using" {
    technology "HTTPS"
  }
  ibs.api.security -[calls]-> ibs.api.email "Triggers security notifications via" {
    technology "Java method call"
  }
  ibs.api.security -[readsFrom]-> ibs.db "Reads from and writes to" {
    technology "SQL/TCP"
  }
  ibs.api.signInApi -[calls]-> ibs.api.security "Authenticates customers with" {
    technology "Java method call"
  }
  ibs.api.statementApi -[calls]-> ibs.api.security "Validates access tokens with" {
    technology "Java method call"
  }
  ibs.api.statementApi -[calls]-> ibs.api.statements "Delegates statement retrieval to" {
    technology "Java method call"
  }
  ibs.api.statements -[calls]-> ibs.api.coreBankingAdapter "Fetches transaction history via" {
    technology "Java method call"
  }
  ibs.api.statements -[readsFrom]-> ibs.statementStore "Reads from and writes to" {
    technology "S3 API/HTTPS"
  }
  ibs.spa -[calls]-> ibs.api "Makes API calls to" {
    technology "JSON/HTTPS"
  }
  ibs.spa -[calls]-> ibs.api.accountsSummaryApi "Requests account overviews from" {
    technology "JSON/HTTPS"
  }
  ibs.spa -[calls]-> ibs.api.signInApi "Submits sign-in requests to" {
    technology "JSON/HTTPS"
  }
  ibs.spa -[calls]-> ibs.api.statementApi "Requests statements from" {
    technology "JSON/HTTPS"
  }
  ibs.spa -[readsFrom]-> ibs.staticContent "Loads its application files from" {
    technology "HTTPS"
  }
  ses -[sendsTo]-> customer "Delivers e-mails to"
}
