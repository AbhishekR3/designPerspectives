{
  "$id": "urn:designperspectives:schema:codemapping",
  "title": "codemapping",
  "description": "Generated from Zod. Applies to architecture/sidecars/codemapping.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)*$"
          },
          "include": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language": {
            "type": "string"
          },
          "pinned": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "element",
          "include"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rules"
  ],
  "additionalProperties": false
}
