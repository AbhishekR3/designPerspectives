{
  "name": "designperspectives-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "ff": "node tools/ff/run-all.mjs",
    "dp": "node apps/cli/dist/bin.js",
    "desktop": "pnpm --filter @designperspectives/desktop start",
    "fixtures": "node fixtures/clone-fixtures.mjs",
    "check": "pnpm build && pnpm lint && pnpm test && pnpm ff"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "remeda": "2.51.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
